# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in. .env is gitignored; never commit it.
# ---------------------------------------------------------------------------

# REQUIRED. Free, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- who it thinks you are -------------------------------------------------
JARVIS_NAME=JARVIS
JARVIS_USER_NAME=sir
JARVIS_TZ=Asia/Kolkata

# --- models ----------------------------------------------------------------
# Verify these against your key with: python -m jarvis.doctor
# Google deprecates model IDs on their own schedule. When one dies, change it
# here and nowhere else.
JARVIS_MODEL_FAST=gemini-3.5-flash-lite
JARVIS_MODEL_SMART=gemini-3.7-flash
JARVIS_MODEL_VISION=gemini-3.5-flash-lite

# --- quota -----------------------------------------------------------------
# IMPORTANT: these defaults are conservative guesses. Free-tier limits change
# without notice and apply per Google Cloud PROJECT, not per key -- making
# three keys does not triple your quota. Check your live numbers in AI Studio
# and put the real ones here. The governor is only as honest as these.
JARVIS_RPM=14
JARVIS_TPM=240000
JARVIS_RPD=180

# Start conserving below this fraction of the daily budget, and go
# user-only below the second one.
JARVIS_CONSERVE_AT=0.25
JARVIS_CRITICAL_AT=0.08

# Daily quotas reset at midnight Pacific, which is mid-afternoon in India.
JARVIS_QUOTA_TZ=America/Los_Angeles

# --- web search -----------------------------------------------------------
# Gemini's built-in google_search grounding tool returns 429 on every call on
# a free-tier key -- measured, not assumed. It is therefore OFF, and search
# runs through DuckDuckGo instead (no key, no quota). Set this to 1 only
# after enabling billing, then confirm with: python -m jarvis.doctor
JARVIS_GOOGLE_SEARCH=0

# --- which folders it may touch ------------------------------------------
# The workspace is always allowed. These are added on top, resolved against
# your home folder, and OneDrive folder redirection is followed automatically.
# Set to an empty string to confine everything to the workspace alone.
# Credential files (.env, SSH keys, *.pem, token JSON) are refused inside
# these folders regardless -- that denylist cannot be switched off.
JARVIS_EXTRA_ROOTS=Desktop;Documents;Downloads

# --- safety ----------------------------------------------------------------
# never  = destructive actions run without asking (the default here)
# smart  = only destructive actions prompt
# always = every non-trivial action prompts
#
# Two things survive JARVIS_APPROVAL=never on purpose:
#   * the hard-deny list, which refuses rather than prompts, so rm -rf / and
#     Format-Volume are still impossible;
#   * the taint guard below.
JARVIS_APPROVAL=never

# With prompts off, this is the last thing between a poisoned web page and a
# destructive action. It only fires when content matching actual injection
# signatures has been read this conversation -- not on every file write. Set
# it to 0 if you want no prompts under any circumstances.
JARVIS_TAINT_GUARD=1
JARVIS_TRASH_DAYS=30

# --- voice -----------------------------------------------------------------
JARVIS_VOICE=1
JARVIS_HOTKEY=ctrl+alt+j
JARVIS_STT_MODEL=base.en
JARVIS_PIPER_VOICE=en_GB-alan-medium
JARVIS_SILENCE=1.2
JARVIS_BARGE_IN=1

# --- agent loop ------------------------------------------------------------
JARVIS_MAX_STEPS=8
JARVIS_MAX_TOOL_CALLS=12
JARVIS_HISTORY_TURNS=12

# store=0 keeps your conversations off Google's servers. On the free tier,
# where prompts may be used to improve Google's products, keep this at 0.
JARVIS_STORE=0

# --- optional: calendar and mail, read-only --------------------------------
# Download an OAuth client secrets JSON from the Google Cloud console.
# Leave blank to disable those tools entirely.
GOOGLE_CREDENTIALS_FILE=
